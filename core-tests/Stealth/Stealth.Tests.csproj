<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared + Stealth (the stealth kit: sight, the detection meter, the seeker, noise, collectibles, the Stealth
       Lab's yard, the answers to fast movement) + Movement (noise reads the movement kit's events; the lucidity fade
       caps its speed) and the movement tests' BoxWorld and kit; the rest comes from Directory.Build.props. -->
  <ItemGroup>
    <Compile Include="$(PkgRoot)Runtime\Core\Stealth\**\*.cs" />
    <Compile Include="$(PkgRoot)Runtime\Core\Movement\**\*.cs" />
    <Compile Include="$(PkgRoot)Tests\Core\Stealth\**\*.cs" />
    <Compile Include="$(PkgRoot)Tests\Core\Movement\BoxWorld.cs" />
    <Compile Include="$(PkgRoot)Tests\Core\Movement\MoveTestKit.cs" />
  </ItemGroup>
</Project>
