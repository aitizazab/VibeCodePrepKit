<Project>
  <!--
    Compile-only checks of the Unity layer (Runtime/Unity, the sandbox, the editor tools and the
    Unity tests) against the Unity editor's DLLs and the package assemblies Unity already built in
    Library/ScriptAssemblies. Catches C# errors in seconds without starting Unity. Nothing runs.
    Needs: Unity 6000.3.25f1 installed and the project opened (or batch-run) once.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <IsTestProject>false</IsTestProject>
    <NoWarn>$(NoWarn);MSB3270;MSB3277;CS0649;CS0414;CS8019</NoWarn>
    <UnityEditorDir Condition="'$(UnityEditorDir)' == ''">C:\Program Files\Unity\Hub\Editor\6000.3.25f1\Editor</UnityEditorDir>
    <ScriptAssemblies>$(MSBuildThisFileDirectory)..\..\Library\ScriptAssemblies\</ScriptAssemblies>
    <ProjectAssets>$(MSBuildThisFileDirectory)..\..\Assets\JamKit\</ProjectAssets>
    <DefineConstants>$(DefineConstants);UNITY_6000_0_OR_NEWER;UNITY_2023_1_OR_NEWER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Remove="Microsoft.NET.Test.Sdk" />
    <PackageReference Remove="NUnit" />
    <PackageReference Remove="NUnit3TestAdapter" />
    <Compile Include="$(PkgRoot)Runtime\Core\**\*.cs" Exclude="$(PkgRoot)Runtime\Core\Shared\**\*.cs" />
    <Compile Remove="$(PkgRoot)Tests\Core\Shared\**\*.cs" />
    <Compile Include="$(PkgRoot)Runtime\Unity\**\*.cs" />
    <Compile Include="$(ProjectAssets)Sandbox\Scripts\**\*.cs" />
    <EngineDll Include="$(UnityEditorDir)\Data\Managed\UnityEngine\UnityEngine*.dll" />
    <Reference Include="@(EngineDll)" Private="false" />
    <PkgDll Include="$(ScriptAssemblies)Unity.InputSystem.dll;$(ScriptAssemblies)UnityEngine.UI.dll;$(ScriptAssemblies)Ink.dll;$(ScriptAssemblies)Ink-Libraries.dll;$(ScriptAssemblies)Unity.RenderPipelines.Universal.Runtime.dll;$(ScriptAssemblies)Unity.RenderPipelines.Core.Runtime.dll" />
    <Reference Include="@(PkgDll)" Private="false" />
  </ItemGroup>
</Project>
