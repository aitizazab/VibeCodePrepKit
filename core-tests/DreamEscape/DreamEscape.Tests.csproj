<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared + Movement + DreamEscape (Visiting Hours' first escape: the dream street's course, run by the
       Movement Lab's autopilot in the fake world). Reuses the Movement tests' BoxWorld and course driver;
       the rest comes from Directory.Build.props. -->
  <ItemGroup>
    <Compile Include="$(PkgRoot)Runtime\Core\Movement\**\*.cs" />
    <Compile Include="$(PkgRoot)Runtime\Core\DreamEscape\**\*.cs" />
    <!-- Night 2's house (DreamHouse) uses the stealth kit: Theo's hide-and-seek. -->
    <Compile Include="$(PkgRoot)Runtime\Core\Stealth\**\*.cs" />
    <!-- The house stands on Larch Hill by the World agent's anchors. -->
    <Compile Include="$(PkgRoot)Runtime\Core\DeepBlock\HillAnchors.cs" />
    <Compile Include="$(PkgRoot)Tests\Core\Movement\BoxWorld.cs" />
    <Compile Include="$(PkgRoot)Tests\Core\Movement\LabCourseTests.cs" />
    <Compile Include="$(PkgRoot)Tests\Core\DreamEscape\**\*.cs" />
  </ItemGroup>
</Project>
