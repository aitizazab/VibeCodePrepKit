<Project Sdk="Microsoft.NET.Sdk">
  <!-- Writes Night 2's house plan (core DreamHouse) as JSON for tools/art/vh_house_plan.py. Not part of Unity.
       Run: dotnet run -c Release (args: the output path) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PkgRoot>$(MSBuildThisFileDirectory)..\..\Packages\com.vibejam.jamkit\</PkgRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(PkgRoot)Runtime\Core\Shared\**\*.cs" />
    <Compile Include="$(PkgRoot)Runtime\Core\Movement\**\*.cs" />
    <Compile Include="$(PkgRoot)Runtime\Core\Stealth\**\*.cs" />
    <Compile Include="$(PkgRoot)Runtime\Core\DreamEscape\**\*.cs" />
    <Compile Include="$(PkgRoot)Runtime\Core\DeepBlock\HillAnchors.cs" />
  </ItemGroup>
</Project>
