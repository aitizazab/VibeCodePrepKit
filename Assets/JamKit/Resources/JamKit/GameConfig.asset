  credits: {fileID: 4900000, guid: c7dc43a8aab8e6f4e9b3f0b1efc963ed, type: 3}
  howToPlay:
  - title: Read and choose
    body: 'Click, Space, Enter or (A) to go on (a click while text types shows it
      all).

      Choices: click one, press its number, or use the arrow keys and
      Enter.'
    image: {fileID: 0}
  - title: Look around
    body: 'Sometimes you can look around a room: click the glowing markers, or use
      the arrow keys and Enter.

      Items you find appear at the bottom left:
      click one, then click where to use it.'
    image: {fileID: 0}
  - title: Your story is remembered
    body: 'L or the mouse wheel shows what was said. A: auto, S or hold Ctrl: skip
      what you''ve read, H: hide the text. F5 / F9: quick save and load. Escape:
      menu.

      The game remembers how your story ended. Play it more than once.'
    image: {fileID: 0}
  showHowToPlayOnFirstRun: 1
  allowDebugMenuInRelease: 0
  showPixelLookSetting: 0
  showTextSettings: 1
  showActionSettings: 0
  showBestTime: 0
