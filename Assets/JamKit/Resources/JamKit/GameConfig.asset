  gameTitle: Last Train Home
  tagline: A short story about what we leave behind.
  bootScene: Boot
  titleScene: Title
  firstGameplayScene: Story
  titleMusic: music_story_calm
  gameMusic: 
  audio: {fileID: 11400000, guid: 24bd74896dbbd514a97d579586e9d96b, type: 2}
  portraits:
  - {fileID: 11400000, guid: 7272992dc05f7d64da45c758e2614ca6, type: 2}
