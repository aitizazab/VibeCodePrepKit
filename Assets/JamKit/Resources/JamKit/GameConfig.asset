  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 945c355521880f545884efe20ab4723b, type: 3}
  m_Name: GameConfig
  m_EditorClassIdentifier: JamKit.Unity::JamKit.Shell.GameConfig
  gameTitle: Corecrawler
  tagline: Three levels down. Find the keys. Find the exit.
  bootScene: Boot
  titleScene: Title
  firstGameplayScene: Doomlike
  titleMusic: music_title
  gameMusic: music_game
  audio: {fileID: 11400000, guid: 24bd74896dbbd514a97d579586e9d96b, type: 2}
  portraits:
  - {fileID: 11400000, guid: 7272992dc05f7d64da45c758e2614ca6, type: 2}
  - {fileID: 11400000, guid: 5c4a424501321a34f86a06cd21a57faf, type: 2}
  credits: {fileID: 4900000, guid: c7dc43a8aab8e6f4e9b3f0b1efc963ed, type: 3}
  howToPlay:
  - title: Move and look
    body: 'WASD or the left stick to move: you run all the time (hold Shift or LB
      to walk). Mouse or the right stick to look.

      Click the game first so
      it can hold the mouse.'
    image: {fileID: 21300000, guid: 159d08fc5c566b44a8d218749d5ea257, type: 3}
  - title: Shoot
    body: 'Left click or RT fires. Keys 1-5, the mouse wheel or Y swap guns.

      Guns
      that fire the same ammo share it: grab boxes to refill. Watch for the red aim
      line: get out of sight before it fires.'
    image: {fileID: 21300000, guid: 4b4aa28d2f44dda49bfa97a16a66b949, type: 3}
  - title: Keys and doors
    body: 'Doors open as you walk up. A coloured door needs the key card of its colour.

      Odd-looking
      walls can hide secrets: walk into them or press E / Space.'
    image: {fileID: 21300000, guid: 053b62bc2aa09e34386496d861d0130b, type: 3}
  - title: Find the exit
    body: 'Each level ends on the glowing EXIT pad. Between levels, pick 1 of 3 upgrades.

      Finish
      level 3 to win. Escape or Start pauses.'
    image: {fileID: 21300000, guid: 34126e1a2c9d5c249a6dac85a14807b8, type: 3}
  showHowToPlayOnFirstRun: 1
  allowDebugMenuInRelease: 0
  showPixelLookSetting: 1
