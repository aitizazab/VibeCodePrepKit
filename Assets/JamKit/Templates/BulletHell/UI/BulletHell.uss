/*
 * Bullet-hell HUD and choice screens. Colours come from the shell's theme (Assets/JamKit/UI/Theme.uss,
 * the --jk-... variables), so re-skinning the theme re-skins this too. Sizes are pixels at 1920x1080.
 * The side panels sit left and right of the playfield (about 380 px each).
 */

.bh-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.bh-side {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 360px;
    padding: 36px 28px;
}

.bh-side--left {
    left: 0;
}

.bh-side--right {
    right: 0;
    padding-top: 150px; /* below the shell's timer and score */
    align-items: flex-end;
}

.bh-kicker {
    font-size: var(--jk-small-size);
    color: var(--jk-text-dim);
    -unity-font-style: bold;
    margin-top: 18px;
    letter-spacing: 2px;
}

.bh-value {
    font-size: var(--jk-font-size);
    -unity-font-style: bold;
    color: var(--jk-text);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.7);
}

.bh-dim {
    color: var(--jk-text-dim);
    font-size: var(--jk-small-size);
}

.bh-hint {
    position: absolute;
    left: 28px;
    bottom: 36px;
    font-size: 20px;
    color: var(--jk-text-dim);
    white-space: normal;
}

.bh-pips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
    min-height: 34px;
    align-items: center;
}

.bh-pip {
    width: 30px;
    height: 30px;
    margin-right: 8px;
    margin-bottom: 6px;
    border-radius: 15px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.85);
}

.bh-pip--life {
    background-color: var(--jk-health);
}

.bh-pip--half {
    background-color: rgba(255, 90, 110, 0.4);
}

.bh-pip--empty {
    background-color: rgba(0, 0, 0, 0.4);
    border-color: rgba(255, 255, 255, 0.25);
}

.bh-pip--bomb {
    background-color: var(--jk-accent);
    border-radius: 6px;
}

.bh-floor {
    font-size: var(--jk-heading-size);
    color: var(--jk-accent);
    -unity-text-align: middle-right;
}

.bh-floor-name {
    font-size: var(--jk-small-size);
    color: var(--jk-text-dim);
    -unity-text-align: middle-right;
    margin-bottom: 12px;
}

.bh-map {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    flex-wrap: wrap;
}

.bh-map-step {
    flex-direction: column;
    margin-left: 6px;
}

.bh-map-cell {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #10101c;
    opacity: 0.55;
}

.bh-map-cell--fork {
    width: 34px;
    height: 26px;
    font-size: 16px;
    margin-bottom: 3px;
    border-width: 2px;
}

.bh-map-cell--done {
    opacity: 0.3;
}

.bh-map-cell--skipped {
    opacity: 0.12;
}

.bh-map-cell--here {
    opacity: 1;
    border-color: var(--jk-text);
    scale: 1.12 1.12;
}

.bh-upgrades {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    margin-top: 8px;
    width: 304px;
}

.bh-upgrade {
    width: 56px;
    height: 56px;
    margin: 4px;
    border-radius: 10px;
    border-width: 3px;
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: scale-to-fit;
}

.bh-upgrade-text {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--jk-text);
}

.bh-upgrade-count {
    position: absolute;
    right: -2px;
    bottom: -4px;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--jk-accent);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.9);
}

/* ---------- Boss ---------- */

.bh-boss {
    position: absolute;
    top: 96px;
    left: 420px;
    right: 420px;
    align-items: stretch;
}

.bh-boss-name {
    font-size: var(--jk-small-size);
    -unity-font-style: bold;
    color: var(--jk-text);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.8);
    margin-bottom: 4px;
}

.bh-boss-bar {
    height: 22px;
    background-color: var(--jk-health-back);
    border-radius: 6px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
    overflow: hidden;
}

.bh-boss-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: var(--jk-bad);
}

.bh-boss-ticks {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    right: 0;
}

.bh-boss-tick {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    background-color: rgba(255, 255, 255, 0.85);
}

.bh-namecard {
    position: absolute;
    left: 0;
    right: 0;
    top: 340px;
    align-items: center;
}

.bh-namecard-title {
    font-size: var(--jk-title-size);
    -unity-font-style: bold;
    color: var(--jk-accent);
    text-shadow: 4px 4px 0 rgba(0, 0, 0, 0.8);
    -unity-text-align: middle-center;
}

.bh-namecard-sub {
    font-size: var(--jk-font-size);
    color: var(--jk-text);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.8);
    -unity-text-align: middle-center;
}

/* ---------- Sprint meter (left panel): dim tank = this room's budget, bright fill = stamina ---------- */

.bh-sprint {
    width: 280px;
    height: 22px;
    margin-top: 8px;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.25);
    overflow: hidden;
}

.bh-sprint-tank {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: rgba(120, 220, 255, 0.22);
}

.bh-sprint-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: rgb(120, 220, 255);
}

.bh-sprint--active {
    border-color: rgb(120, 220, 255);
}

.bh-sprint--tired .bh-sprint-fill {
    background-color: rgba(120, 220, 255, 0.45);
}

.bh-sprint--empty {
    border-color: var(--jk-bad);
}

.bh-sprint--flash {
    border-color: var(--jk-bad);
    background-color: rgba(255, 90, 90, 0.55);
}

.bh-sprint-text {
    font-size: 20px;
    color: var(--jk-text-dim);
    margin-top: 4px;
}

/* ---------- First-run Focus hint (below the ship's starting spot) ---------- */

.bh-focus-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 28px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.bh-focus-hint-pill {
    flex-direction: row;
    align-items: center;
    background-color: rgba(10, 10, 24, 0.85);
    border-width: var(--jk-border);
    border-color: var(--jk-accent);
    border-radius: var(--jk-radius);
    padding: 14px 32px 14px 20px;
}

.bh-key {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--jk-accent-text);
    background-color: var(--jk-accent);
    border-radius: 10px;
    border-bottom-width: 6px;
    border-bottom-color: rgba(0, 0, 0, 0.35);
    padding: 8px 22px 6px 22px;
    margin-right: 22px;
    -unity-text-align: middle-center;
}

.bh-focus-hint-text {
    font-size: var(--jk-font-size);
    -unity-font-style: bold;
    color: var(--jk-text);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.85);
}

.bh-focus-hint-sub {
    font-size: var(--jk-small-size);
    color: var(--jk-text-dim);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.85);
}

/* ---------- Choice screens (draft, doors, shop, rest) ---------- */

.bh-choice {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--jk-scrim);
}

.bh-choice-panel {
    align-items: center;
    max-width: 1800px;
}

.bh-cards {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin: 16px 0 20px 0;
}

.bh-card {
    width: 360px;
    min-height: 320px;
    margin: 10px 14px;
    padding: 22px 22px 18px 22px;
    background-image: none;
    background-color: var(--jk-panel);
    border-width: var(--jk-border);
    border-top-width: 10px;
    border-color: var(--jk-panel-border);
    border-radius: var(--jk-radius);
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    transition-duration: 0.08s;
}

.bh-card:hover {
    background-color: var(--jk-button-hover);
}

.bh-card:focus {
    border-left-color: var(--jk-accent);
    border-right-color: var(--jk-accent);
    border-bottom-color: var(--jk-accent);
    background-color: var(--jk-button-hover);
    scale: 1.05 1.05;
}

.bh-card:disabled {
    opacity: 0.45;
}

.bh-card-icon {
    height: 80px;
    margin-bottom: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.bh-card-kicker {
    font-size: var(--jk-small-size);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    letter-spacing: 2px;
}

.bh-card-title {
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: var(--jk-text);
    white-space: normal;
    margin: 6px 0 10px 0;
}

.bh-card-body {
    font-size: var(--jk-small-size);
    -unity-text-align: upper-left;
    color: var(--jk-text-dim);
    white-space: normal;
    flex-grow: 1;
}

.bh-card-price {
    font-size: var(--jk-font-size);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: var(--jk-accent);
    margin-top: 10px;
}

/* ---------- Round 2: encounters, trials, companion, remnants ---------- */

.bh-choice-note {
    color: var(--jk-accent);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 6px;
    white-space: normal;
    max-width: 1200px;
}

.bh-cards--compact .bh-card {
    width: 260px;
    min-height: 170px;
    margin: 6px 8px;
    padding: 14px 16px 12px 16px;
}

.bh-cards--compact .bh-card-title {
    font-size: 28px;
    margin: 4px 0 6px 0;
}

.bh-cards--compact .bh-card-icon {
    height: 44px;
}

.bh-trials {
    margin-top: 6px;
}

.bh-trial-line {
    font-size: var(--jk-small-size);
    color: var(--jk-text);
    white-space: normal;
    margin-bottom: 4px;
}

.bh-trial-line--done {
    color: rgb(120, 255, 160);
}

.bh-trial-line--failed {
    color: rgb(255, 120, 120);
}

.bh-guard {
    height: 12px;
    margin-top: 2px;
    margin-bottom: 4px;
    background-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    overflow: hidden;
}

.bh-guard-fill {
    height: 100%;
    width: 100%;
    background-color: rgba(255, 215, 140, 0.55);
}

.bh-guard--ready .bh-guard-fill {
    background-color: rgb(255, 215, 140);
}

.bh-bark {
    position: absolute;
    bottom: 22%;
    left: 30%;
    right: 30%;
    align-items: center;
    display: none;
}

.bh-bark-pill {
    flex-direction: row;
    align-items: center;
    padding: 10px 22px;
    background-color: rgba(10, 12, 24, 0.82);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    border-left-width: 3px;
    border-left-color: rgb(255, 215, 140);
}

.bh-bark-speaker {
    font-size: var(--jk-small-size);
    -unity-font-style: bold;
    color: rgb(255, 215, 140);
    margin-right: 12px;
}

.bh-bark-text {
    font-size: var(--jk-font-size);
    color: var(--jk-text);
    white-space: normal;
}

.bh-upgrade--remnant {
    border-top-width: 3px;
    border-bottom-width: 3px;
}

.bh-upgrade-forged {
    position: absolute;
    left: 2px;
    top: 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 170, 80);
}
