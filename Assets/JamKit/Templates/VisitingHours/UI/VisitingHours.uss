/* Visiting Hours: the slice's HUD, journal, argument box, cards, opening and title look.
   Sizes are at the shell's 1920x1080 reference. Paintings are never pixelated here. */

.vh-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ---------- HUD ---------- */

.vh-vignette {
    -unity-background-scale-mode: stretch-to-fill;
    transition-property: opacity;
    transition-duration: 1.2s;
}

.vh-dim {
    background-color: rgb(0, 0, 0);
}

.vh-dot {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    margin-top: -3px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: rgba(255, 255, 255, 0.55);
}

.vh-dot--target {
    width: 12px;
    height: 12px;
    margin-left: -6px;
    margin-top: -6px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(255, 226, 170, 0.9);
}

.vh-prompt {
    position: absolute;
    left: 0;
    right: 0;
    top: 58%;
    font-size: 30px;
    -unity-text-align: middle-center;
    color: rgb(255, 246, 230);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.85);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.vh-journal-hint {
    position: absolute;
    left: 36px;
    bottom: 30px;
    font-size: 24px;
    color: rgba(255, 250, 240, 0.7);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
}

.vh-journal-hint--open {
    color: rgb(255, 214, 150);
}

.vh-controls {
    position: absolute;
    left: 0;
    right: 0;
    top: 40px;
    font-size: 24px;
    -unity-text-align: middle-center;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.85);
    transition-property: opacity;
    transition-duration: 1.5s;
}

.vh-toast {
    position: absolute;
    right: 40px;
    top: 120px;
    padding: 14px 22px;
    font-size: 24px;
    color: rgb(52, 42, 30);
    background-color: rgba(238, 228, 206, 0.94);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    rotate: -1deg;
    transition-property: opacity;
    transition-duration: 0.6s;
}

.vh-card {
    background-color: rgb(0, 0, 0);
    align-items: center;
    justify-content: center;
}

.vh-card__title {
    font-size: 64px;
    color: rgb(238, 234, 226);
    -unity-text-align: middle-center;
    letter-spacing: 4px;
}

.vh-card__sub {
    margin-top: 12px;
    font-size: 30px;
    color: rgba(238, 234, 226, 0.6);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
}

.vh-end {
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
}

.vh-end__panel {
    width: 900px;
    padding: 48px 56px;
    background-color: rgba(18, 18, 22, 0.95);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.2);
    border-right-color: rgba(255, 255, 255, 0.2);
    border-top-color: rgba(255, 255, 255, 0.2);
    border-bottom-color: rgba(255, 255, 255, 0.2);
}

.vh-end__title {
    font-size: 48px;
    color: rgb(240, 236, 228);
    margin-bottom: 18px;
}

.vh-end__body {
    font-size: 28px;
    color: rgba(240, 236, 228, 0.85);
    white-space: normal;
    margin-bottom: 30px;
}

.vh-end__buttons {
    flex-direction: row;
    justify-content: flex-end;
}

/* ---------- The journal ---------- */

.vh-journal {
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.vh-journal__book {
    width: 1560px;
    height: 900px;
    padding: 40px 52px;
    background-color: rgb(236, 226, 204);
    -unity-background-scale-mode: stretch-to-fill;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.vh-journal__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

.vh-journal__title {
    font-size: 40px;
    color: rgb(56, 44, 32);
    -unity-font-style: italic;
    flex-grow: 1;
}

.vh-journal__tabs {
    flex-direction: row;
}

.vh-journal__tab,
.vh-journal__close,
.vh-journal__combine {
    font-size: 24px;
    padding: 8px 18px;
    margin-left: 8px;
    color: rgb(56, 44, 32);
    background-color: rgba(120, 96, 64, 0.12);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(56, 44, 32, 0.25);
}

.vh-journal__tab:hover,
.vh-journal__tab:focus,
.vh-journal__close:hover,
.vh-journal__close:focus,
.vh-journal__combine:hover,
.vh-journal__combine:focus {
    background-color: rgba(120, 96, 64, 0.28);
}

.vh-journal__tab--on {
    border-bottom-color: rgb(150, 60, 40);
    -unity-font-style: bold;
}

.vh-journal__body {
    flex-direction: row;
    flex-grow: 1;
}

.vh-journal__list {
    width: 420px;
    margin-right: 28px;
}

.vh-journal__entry {
    flex-direction: row;
    align-items: center;
    height: 84px;
    margin-bottom: 8px;
    padding: 6px 10px;
    background-color: rgba(255, 255, 255, 0.25);
    border-left-width: 4px;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-color: rgba(0, 0, 0, 0);
}

.vh-journal__entry:hover,
.vh-journal__entry:focus {
    background-color: rgba(255, 255, 255, 0.5);
}

.vh-journal__entry--picked {
    border-left-color: rgb(150, 60, 40);
    background-color: rgba(255, 236, 200, 0.7);
}

.vh-journal__entry--new .vh-journal__entry-title {
    -unity-font-style: bold;
}

.vh-journal__entry--open .vh-journal__entry-title {
    color: rgb(140, 66, 40);
}

.vh-journal__entry-icon {
    width: 70px;
    height: 70px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.vh-journal__entry-title {
    font-size: 24px;
    color: rgb(56, 44, 32);
    white-space: normal;
    flex-shrink: 1;
}

.vh-journal__detail {
    flex-grow: 1;
    margin-right: 28px;
}

.vh-journal__detail-icon {
    height: 260px;
    margin-bottom: 14px;
    -unity-background-scale-mode: scale-to-fit;
}

.vh-journal__detail-title {
    font-size: 34px;
    color: rgb(56, 44, 32);
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.vh-journal__detail-text {
    font-size: 27px;
    color: rgb(62, 50, 38);
    white-space: normal;
}

/* Nadia's scribbled-out note: struck through and faint, legible if you look closely (hover). */
.vh-journal__scribble {
    margin-top: 18px;
    font-size: 27px;
    color: rgb(40, 34, 60);
    -unity-font-style: italic;
    opacity: 0.32;
    rotate: -2deg;
    transition-property: opacity;
    transition-duration: 0.6s;
}

.vh-journal__scribble:hover {
    opacity: 0.85;
}

.vh-journal__side {
    width: 440px;
}

.vh-journal__side-title {
    font-size: 26px;
    color: rgb(56, 44, 32);
    -unity-font-style: bold;
    margin-top: 6px;
    margin-bottom: 8px;
}

.vh-journal__question {
    font-size: 22px;
    color: rgb(130, 62, 38);
    white-space: normal;
    margin-bottom: 10px;
    -unity-font-style: italic;
}

.vh-journal__questions {
    margin-bottom: 18px;
}

.vh-journal__pick {
    font-size: 22px;
    color: rgb(56, 44, 32);
    padding: 6px 10px;
    margin-bottom: 6px;
    background-color: rgba(255, 255, 255, 0.3);
}

.vh-journal__combine {
    margin-left: 0;
    margin-top: 6px;
}

.vh-journal__result {
    margin-top: 12px;
    font-size: 23px;
    color: rgb(62, 50, 38);
    white-space: normal;
    -unity-font-style: italic;
}

.vh-journal__tutorial {
    margin-top: 10px;
    font-size: 22px;
    color: rgb(150, 60, 40);
    white-space: normal;
}

/* ---------- The argument ---------- */

.vh-battle {
    background-color: rgba(10, 8, 6, 0.72);
    align-items: center;
}

.vh-battle__portrait {
    width: 560px;
    height: 330px;
    margin-top: 20px;
    -unity-background-scale-mode: scale-to-fit;
}

.vh-battle__statement {
    font-size: 34px;
    color: rgb(255, 246, 230);
    -unity-text-align: middle-center;
    margin-top: 6px;
    margin-bottom: 14px;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
    opacity: 0.6;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.vh-battle__statement--in {
    opacity: 1;
}

.vh-battle__box {
    position: relative;
    overflow: hidden;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(240, 236, 228);
    border-right-color: rgb(240, 236, 228);
    border-top-color: rgb(240, 236, 228);
    border-bottom-color: rgb(240, 236, 228);
    background-color: rgb(8, 8, 10);
}

.vh-battle__zone {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    align-items: center;
    justify-content: center;
    transition-property: background-color;
    transition-duration: 0.35s;
}

.vh-battle__zone--press {
    background-color: rgba(120, 40, 30, 0.12);
}

.vh-battle__zone--press.vh-battle__zone--on {
    background-color: rgba(150, 52, 36, 0.3);
}

.vh-battle__zone--listen {
    background-color: rgba(70, 110, 150, 0.1);
}

.vh-battle__zone--listen.vh-battle__zone--on {
    background-color: rgba(110, 160, 210, 0.22);
}

.vh-battle__zone-word {
    font-size: 30px;
    color: rgb(255, 255, 255);
    letter-spacing: 12px;
    -unity-font-style: italic;
}

.vh-battle__bullets {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.vh-battle__light {
    position: absolute;
    left: 0;
    top: 0;
    width: 26px;
    height: 26px;
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
    border-bottom-left-radius: 13px;
    border-bottom-right-radius: 13px;
    background-color: rgb(255, 244, 214);
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgba(255, 220, 160, 0.45);
    border-right-color: rgba(255, 220, 160, 0.45);
    border-top-color: rgba(255, 220, 160, 0.45);
    border-bottom-color: rgba(255, 220, 160, 0.45);
}

.vh-battle__light--press {
    background-color: rgb(255, 206, 180);
}

.vh-battle__object {
    position: absolute;
    left: 0;
    top: 0;
    width: 90px;
    height: 90px;
    align-items: center;
}

.vh-battle__object-icon {
    width: 70px;
    height: 70px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(255, 244, 214, 0.12);
    border-top-left-radius: 35px;
    border-top-right-radius: 35px;
    border-bottom-left-radius: 35px;
    border-bottom-right-radius: 35px;
}

.vh-battle__object-label {
    font-size: 16px;
    color: rgb(255, 240, 210);
    -unity-text-align: upper-center;
    white-space: nowrap;
}

.vh-battle__pips {
    flex-direction: row;
    margin-top: 14px;
}

.vh-battle__pip {
    width: 16px;
    height: 16px;
    margin-left: 6px;
    margin-right: 6px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgb(255, 238, 200);
}

.vh-battle__pip--lost {
    background-color: rgba(255, 238, 200, 0.15);
}

.vh-battle__say {
    margin-top: 16px;
    font-size: 28px;
    color: rgb(200, 220, 255);
    -unity-text-align: middle-center;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.vh-battle__reply {
    margin-top: 6px;
    font-size: 30px;
    color: rgb(255, 240, 220);
    -unity-text-align: middle-center;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.vh-battle__hint {
    position: absolute;
    bottom: 26px;
    font-size: 22px;
    color: rgba(255, 255, 255, 0.6);
}

/* ---------- The opening (over the 3D bedroom; docs/OPENING-AND-TITLE.md) ---------- */

.vh-opening {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Under the blanket: dark, a little warm at the edges where light gets in. */
.vh-opening__blanket {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(9, 10, 16);
    border-left-width: 90px;
    border-right-width: 90px;
    border-top-width: 60px;
    border-bottom-width: 60px;
    border-left-color: rgb(20, 20, 27);
    border-right-color: rgb(20, 20, 27);
    border-top-color: rgb(16, 16, 22);
    border-bottom-color: rgb(24, 23, 28);
    opacity: 0;
}

.vh-opening__subtitle {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 56px;
    font-size: 30px;
    color: rgb(238, 236, 232);
    -unity-text-align: middle-center;
    white-space: normal;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.95);
}

.vh-opening__black {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
}

.vh-opening__skip {
    position: absolute;
    right: 30px;
    top: 24px;
    font-size: 20px;
    color: rgba(255, 255, 255, 0.6);
}

.vh-opening__retime {
    position: absolute;
    left: 40px;
    right: 40px;
    top: 24px;
    font-size: 26px;
    color: rgb(255, 214, 120);
    white-space: normal;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.95);
}

/* ---------- The phone's screen (drawn into a texture on the phone: 360 x 740) ---------- */

.vh-phone {
    position: absolute;
    left: 0;
    top: 0;
    width: 360px;
    height: 740px;
    background-color: rgb(40, 44, 64);
    -unity-background-scale-mode: scale-and-crop;
    padding-top: 18px;
}

.vh-phone__status {
    flex-direction: row;
    justify-content: space-between;
    padding-left: 22px;
    padding-right: 22px;
    height: 34px;
}

.vh-phone__status-time,
.vh-phone__status-battery {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.85);
}

.vh-phone__page {
    flex-grow: 1;
    align-items: center;
}

.vh-phone__rings {
    margin-top: 110px;
    width: 180px;
    height: 180px;
    align-items: center;
    justify-content: center;
}

.vh-phone__ring {
    position: absolute;
    left: 0;
    top: 0;
    width: 180px;
    height: 180px;
    border-radius: 90px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgba(220, 230, 255, 0.7);
    border-right-color: rgba(220, 230, 255, 0.7);
    border-top-color: rgba(220, 230, 255, 0.7);
    border-bottom-color: rgba(220, 230, 255, 0.7);
}

.vh-phone__avatar {
    width: 120px;
    height: 120px;
    border-radius: 60px;
    background-color: rgb(118, 128, 150);
    align-items: center;
    justify-content: center;
}

.vh-phone__avatar--small {
    margin-top: 70px;
    width: 96px;
    height: 96px;
    border-radius: 48px;
}

.vh-phone__avatar-letter {
    font-size: 56px;
    color: rgb(240, 242, 248);
    -unity-font-style: bold;
}

.vh-phone__name {
    margin-top: 26px;
    font-size: 46px;
    color: rgb(246, 246, 250);
}

.vh-phone__sub {
    margin-top: 6px;
    font-size: 22px;
    color: rgba(235, 238, 248, 0.75);
}

.vh-phone__buttons {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 80px;
    flex-direction: row;
    justify-content: space-around;
}

.vh-phone__button {
    width: 86px;
    height: 86px;
    border-radius: 43px;
}

.vh-phone__button--decline {
    background-color: rgb(176, 84, 84);
}

.vh-phone__button--accept {
    background-color: rgb(92, 160, 112);
}

.vh-phone__clock {
    margin-top: 70px;
    font-size: 96px;
    color: rgb(244, 244, 248);
}

.vh-phone__date {
    font-size: 22px;
    color: rgba(240, 240, 248, 0.8);
    margin-bottom: 40px;
}

.vh-phone__card {
    width: 316px;
    margin-top: 14px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 14px;
    padding-bottom: 14px;
    border-radius: 18px;
    background-color: rgba(236, 238, 246, 0.86);
}

.vh-phone__card--voicemail {
    background-color: rgba(214, 226, 246, 0.92);
}

.vh-phone__card-title {
    font-size: 18px;
    color: rgb(90, 96, 112);
}

.vh-phone__card-name {
    font-size: 28px;
    color: rgb(30, 34, 44);
}

.vh-phone__card-play {
    margin-top: 6px;
    font-size: 20px;
    color: rgb(52, 96, 160);
    -unity-font-style: bold;
}

.vh-phone__header {
    margin-top: 30px;
    font-size: 24px;
    color: rgba(240, 242, 248, 0.85);
}

.vh-phone__bar {
    margin-top: 60px;
    width: 280px;
    height: 8px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.25);
}

.vh-phone__bar-fill {
    height: 8px;
    width: 0;
    border-radius: 4px;
    background-color: rgb(228, 234, 248);
}

.vh-phone__time {
    margin-top: 12px;
    font-size: 20px;
    color: rgba(240, 242, 248, 0.8);
}

.vh-phone__speaker {
    margin-top: 50px;
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-radius: 24px;
    font-size: 22px;
    color: rgba(240, 242, 248, 0.6);
    background-color: rgba(255, 255, 255, 0.08);
}

.vh-phone__speaker--on {
    color: rgb(30, 34, 44);
    background-color: rgba(236, 240, 250, 0.9);
}

/* ---------- The tablet's screen (drawn into a texture on the tablet: 1024 x 640) ---------- */

.vh-tablet {
    position: absolute;
    left: 0;
    top: 0;
    width: 1024px;
    height: 640px;
    background-color: rgb(6, 7, 10);
}

.vh-tablet__video {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.vh-tablet__frames {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.vh-tablet__frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.vh-tablet__light {
    position: absolute;
    width: 260px;
    height: 200px;
    -unity-background-scale-mode: stretch-to-fill;
}

.vh-tablet__light--red {
    left: 380px;
    top: 170px;
    -unity-background-image-tint-color: rgb(255, 70, 60);
}

.vh-tablet__light--blue {
    left: 470px;
    top: 160px;
    -unity-background-image-tint-color: rgb(70, 120, 255);
}

.vh-tablet__live {
    position: absolute;
    left: 28px;
    top: 24px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 4px;
    padding-bottom: 4px;
    background-color: rgb(176, 36, 36);
}

.vh-tablet__live-text {
    font-size: 26px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.vh-tablet__bug {
    position: absolute;
    right: 28px;
    top: 26px;
    font-size: 22px;
    color: rgba(255, 255, 255, 0.75);
    -unity-font-style: bold;
}

.vh-tablet__lower {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 72px;
    flex-direction: row;
    background-color: rgba(18, 20, 30, 0.92);
}

.vh-tablet__tag {
    width: 190px;
    height: 72px;
    align-items: center;
    justify-content: center;
    background-color: rgb(176, 36, 36);
}

.vh-tablet__tag-text {
    font-size: 28px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.vh-tablet__strip {
    flex-grow: 1;
    height: 72px;
    overflow: hidden;
    justify-content: center;
}

.vh-tablet__headline {
    position: absolute;
    left: 0;
    top: 16px;
    font-size: 34px;
    color: rgb(250, 250, 250);
    -unity-font-style: bold;
    white-space: nowrap;
}

.vh-tablet__veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
}

.vh-tablet__play {
    position: absolute;
    left: 412px;
    top: 220px;
    width: 200px;
    height: 200px;
}
