MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e49adf964781779439f610a829ea0aa2, type: 3}
  m_Name: VisitingHoursConfig
  m_EditorClassIdentifier: JamKit.VisitingHours::JamKit.VisitingHours.VisitingHoursConfig
  story: {fileID: 6231892579173505729, guid: bdb3a72ee3301a04083966d264c841c0, type: 3}
  entries:
  - id: fact_chart
    kind: 0
    title: His chart
    text: 'Charting: GCS 6. No sedation. Scans normal. He just won''t wake up.'
    scribble: 
    sayLine: Your scans are normal, Eli. There's no reason you can't wake up.
    icon: prop_chart
  - id: fact_effects
    kind: 0
    title: His effects bag
    text: "His things, in a bag with his name on it. A keyring with a tag: \"W.A.
      workshop\". A folded memorial card: Walter Abernathy, 1941\u20132015."
    scribble: 
    sayLine: These are his keys. Your workshop, Walt.
    icon: prop_effects_bag
  - id: fact_police_report
    kind: 0
    title: The police report
    text: 'An envelope at the station, for the family. Route 9, about 3:40 AM: the
      car was caught in a crossfire (gang violence: the Larpaca gang). Driver: Elias
      Lasname, critical. Lena Lasname and Theo Lasname, dead at the scene.

      Phone log: 3:03, call to Nadia Lasname, not answered. 3:06, call to Lena Lasname,
      2 minutes.'
    scribble: I should have
    sayLine: There's a police report, Walt.
    icon: prop_police_envelope
  - id: fact_photo
    kind: 0
    title: The photo
    text: 'On his bedside table: Eli, Lena and Theo on the beach, laughing so hard
      Theo''s a blur.'
    scribble: 
    sayLine: He has a family. Had.
    icon: prop_family_photo
  - id: mem_walt_alive
    kind: 1
    title: Walt at the grill
    text: Mr. Abernathy at the barbecue, waving at me with the tongs. Flat cap, apron,
      the moustache. Exactly like when we were kids.
    scribble: 
    sayLine: You're at the grill, waving. Like always.
    icon: portrait_walt_neutral
  - id: mem_newspaper
    kind: 1
    title: The newspaper
    text: The Courier, still in its plastic on a porch. Sunday, 23 August. The morning
      of the crash.
    scribble: 
    sayLine: The paper on the porch says Sunday.
    icon: prop_newspaper
  - id: mem_shop_sign
    kind: 1
    title: The shop sign
    text: '"Abernathy Cycles, since 1971." Walt''s garage. Eli spent every summer
      in there with grease up to his elbows.'
    scribble: 
    sayLine: Abernathy Cycles. Since 1971.
    icon: flat_bike_garage
  - id: mem_saturday
    kind: 1
    title: Saturday
    text: The radio says it's Saturday. Mrs. Lindqvist says it's Saturday. Everyone
      here is very sure it's Saturday.
    scribble: 
    sayLine: Everyone keeps telling me it's Saturday.
    icon: billboard_neighbor_roses
  - id: ded_walt_dead
    kind: 2
    title: Walt can't be here
    text: Walt died in 2015. He can't be here.
    scribble: 
    sayLine: Walt. You died in 2015. Eli gave the eulogy.
    icon: prop_memorial_card
  - id: ded_day_before
    kind: 2
    title: The day before
    text: He's living the day before the crash, over and over.
    scribble: 
    sayLine: Not this. You can't fix this by doing it again.
    icon: prop_newspaper
  - id: truth_walt
    kind: 3
    title: Why Walt
    text: He brings Walt back because Walt is the one who told him you can fix anything.
    scribble: 
    sayLine: 
    icon: prop_wrench
  - id: pers_wrench
    kind: 4
    title: Walt's wrench
    text: He pressed it into my hand, warm from the sun. "For the next thing that
      needs fixing."
    scribble: 
    sayLine: 
    icon: prop_wrench
  pairs:
  - a: fact_effects
    b: mem_walt_alive
    result: ded_walt_dead
    question: "The card in Eli's bag says Walter Abernathy, 1941\u20132015. And Walt
      is at the grill, waving."
  - a: mem_newspaper
    b: mem_saturday
    result: ded_day_before
    question: The paper on the porch is from the morning of the crash. Everyone says
      it's Saturday.
  gentleLines:
  - Those don't go together. Not yet.
  - I'm reaching. Leave it.
  - No. That's not it.
