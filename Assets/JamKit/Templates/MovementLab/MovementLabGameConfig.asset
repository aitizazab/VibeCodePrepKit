  gameTitle: Movement Lab
  tagline: Slide, wallrun, double jump. Keep your speed.
  bootScene: Boot
  titleScene: Title
  firstGameplayScene: MovementLab
  titleMusic: music_title
  gameMusic: 
  audio: {fileID: 0}
  portraits: []
  credits: {fileID: 0}
  howToPlay:
  - title: Move
    body: 'WASD or the left stick; you sprint on your own. Mouse or right stick to
      look.

      Space (A) jumps, and jumps again in the air. Ctrl or C (B) slides
      when you''re running.'
    image: {fileID: 0}
  - title: Keep your speed
    body: 'Jump at a wall along it and hold forward to run on it; jump off it quickly
      to keep your speed. Ledges pull you up by themselves.

      F3 (View) shows
      your speed. Esc > Comfort and camera for the field of view and the effects.'
    image: {fileID: 0}
  showHowToPlayOnFirstRun: 1
