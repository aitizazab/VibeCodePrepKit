  endings:
  - id: last_train
    title: The Last Train
    description: You caught the 23:52. Somebody stayed behind.
    hint: Some people get on the train.
    secret: 0
    image: {fileID: 21300000, guid: ed727c46d95045348a138ba8f2fd3b3c, type: 3}
    color: {r: 0.35686275, g: 0.27058825, b: 0.17254902, a: 1}
  - id: missed_connection
    title: Missed Connection
    description: You missed the last train on purpose, and walked home at sunrise.
    hint: Some people stay.
    secret: 0
    image: {fileID: 21300000, guid: 81522586da2306f4796bb5b211e5b939, type: 3}
    color: {r: 0.3254902, g: 0.34509805, b: 0.5411765, a: 1}
  - id: lost_property
    title: Lost Property
    description: You gave away your ticket. Something lost was found.
    hint: Some things belong to someone. Look carefully in the office.
    secret: 0
    image: {fileID: 21300000, guid: a56355b9d54cf954382a4bbabc10c7d4, type: 3}
    color: {r: 0.7058824, g: 0.5764706, b: 0.37254903, a: 1}
  - id: return_ticket
    title: Return Ticket
    description: You came back, and this time she left the station.
    hint: 
    secret: 1
    image: {fileID: 21300000, guid: 7fe8b132ba64cbb4c8df5b0c39ed2add, type: 3}
    color: {r: 0.14901961, g: 0.1882353, b: 0.30980393, a: 1}
  titleVariants:
  - condition: endings_seen >= 1 && !ending:return_ticket
    title: 
    tagline: Somebody is still waiting on the platform.
    playLabel: Go back
